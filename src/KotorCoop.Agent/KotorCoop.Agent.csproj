<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Placeholder art (tools/generate-icon.ps1); swap the .ico for real artwork whenever it exists. -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!--
      tools/package.ps1 overrides this with -p:InformationalVersion=<git describe> on every
      packaged publish, so PackageInstaller.ReadVersion (FileVersionInfo.ProductVersion) can
      tell a player which release is already installed vs. the one about to go in. A plain
      `dotnet build` dev binary (demo.ps1, build.ps1 -Install) keeps this literal placeholder
      instead - a command-line -p: value is a global property the project file cannot
      override, so this only ever applies when nothing else set it.
    -->
    <InformationalVersion>0.0.0-dev</InformationalVersion>
    <!-- Otherwise the SDK appends "+<full git sha>" to InformationalVersion automatically,
         turning the clean git-describe string above into unreadable noise in the player-
         facing "kotor-coop X is already installed" message. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    `dotnet publish` (tools/package.ps1, CI) produces ONE self-contained KotorCoop.Agent.exe
    that carries its own .NET runtime, so a player needs nothing installed — and, the reason
    it went in: a Linux/Steam Deck player running the game under Proton has no way to put a
    Windows .NET runtime into the Wine prefix that is not worse than this. Single-file keeps
    the game directory to KotorCoop.* files, which is the rule the uninstaller relies on
    (PackageInstaller.cs); the ~38 MB is compressed in place. Not trimmed: three JSON
    (de)serialisations and CoopAgent.TopFrame use reflection the trimmer rejects, and the
    saving is not worth the risk in a process that talks to a game's memory.

    `dotnet build` is untouched (framework-dependent, plain bin\Debug path): that is what
    tools/demo.ps1 and build.ps1 -Install run on the rig, and it starts faster.
    _IsPublishing is what the `dotnet publish` CLI sets; the SDK's own PublishRelease default
    keys off the same property.
  -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KotorCoop.Session\KotorCoop.Session.csproj" />

    <!--
      Optional at RUNTIME, not at build time: KotorCoop.Steam is always published (it is a
      KotorCoop.* file, so tools/package.ps1 is happy), but it loads nothing until something
      asks it to and does nothing at all without a steam_api64.dll the player supplied.
      docs/research/steam-support.md §§10-12.
    -->
    <ProjectReference Include="..\KotorCoop.Steam\KotorCoop.Steam.csproj" />

    <!--
      The dashboard's TUI (AgentDashboard.cs). Replaced a hand-rolled VT/alternate-screen
      renderer (2026-09-25) that a live pass found unusable — flicker, overlap and typing
      latency, all symptoms of hand-rolling terminal I/O instead of using a library that
      already solved it. Pure managed, no native assets, and its own NuGet package directly
      targets net10.0 (see the package's dependency list), so it carries cleanly through the
      self-contained single-file publish above with nothing extra to worry about trimming or
      extracting. 2.5.x is the current stable v2 line (gui-cs/tui-cs, MIT, ~11k stars,
      actively released) - NOT a preview: earlier v2 alphas existed, but this release line is
      what "prefer v2 if stable enough" resolves to as of this pass.
    -->
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />

    <!--
      Terminal.Gui depends on TextMateSharp (TextMate-grammar syntax highlighting, an opt-in
      feature no view this project uses ever turns on) for EVERY app that references it, not
      just ones that use highlighting - and TextMateSharp.Grammars pulls in a NATIVE
      Oniguruma regex wrapper (libonigwrap.dll) to do it. A native DLL cannot fold into the
      self-contained single-file publish the way a managed assembly does; it publishes as a
      loose file beside KotorCoop.Agent.exe, which trips tools/package.ps1's own "every file
      in the publish output is KotorCoop.*" check (the uninstaller's whole "everything
      KotorCoop.* is ours" rule depends on that being true). These two direct references pin
      the SAME transitive versions Terminal.Gui 2.5.0 already resolves and exclude just their
      native asset - the managed TextMateSharp API Terminal.Gui itself references still
      resolves normally, so this only removes a regex engine nothing in this project's own
      code path (no syntax highlighting is ever configured) can reach.
    -->
    <PackageReference Include="TextMateSharp" Version="2.0.4" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />

    <!--
      The actual owner of libonigwrap.dll: TextMateSharp depends on Onigwrap for its Oniguruma
      regex wrapper. Pinning + excluding ITS native asset directly is what's needed - the two
      references above only pin TextMateSharp/TextMateSharp.Grammars' own managed assets
      (ExcludeAssets on THOSE packages does not reach a further transitive dependency's own
      assets, which is why that alone left libonigwrap.dll in the publish output).
    -->
    <PackageReference Include="Onigwrap" Version="1.0.11" ExcludeAssets="native" />
  </ItemGroup>

  <!--
    Pure arithmetic, no plugin dependency, shared by source so the dashboard's "log" file
    (the run command's log option) rotates the same way the plugin's own logs do. See
    src/KotorCoop.Plugin/LogRotation.cs.
  -->
  <ItemGroup>
    <Compile Include="..\KotorCoop.Plugin\LogRotation.cs" Link="Plugin\LogRotation.cs" />

    <!--
      The dashboard's own command line (DashboardInputLine.cs) completes and recalls history
      through the SAME dependency-free classes the in-game ~ console uses, linked in by
      source exactly like LogRotation.cs above rather than copied — so the two consoles can
      never drift onto two different verb lists or two different history behaviours. Also
      linked into tests/KotorCoop.Tests/KotorCoop.Tests.csproj; see
      ConsoleCompletionEngine.cs's own doc comment for why these compile cleanly with no
      engine/pointer dependency.
    -->
    <Compile Include="..\KotorCoop.Plugin\ConsoleCompletionEngine.cs" Link="Plugin\ConsoleCompletionEngine.cs" />
    <Compile Include="..\KotorCoop.Plugin\ConsoleVerbCatalog.cs" Link="Plugin\ConsoleVerbCatalog.cs" />
    <Compile Include="..\KotorCoop.Plugin\ConsoleHistoryRing.cs" Link="Plugin\ConsoleHistoryRing.cs" />
  </ItemGroup>

</Project>
