<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Placeholder art (tools/generate-icon.ps1); swap the .ico for real artwork whenever it exists. -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    `dotnet publish` (tools/package.ps1, CI) produces ONE self-contained KotorCoop.Agent.exe
    that carries its own .NET runtime, so a player needs nothing installed — and, the reason
    it went in: a Linux/Steam Deck player running the game under Proton has no way to put a
    Windows .NET runtime into the Wine prefix that is not worse than this. Single-file keeps
    the game directory to KotorCoop.* files, which is the rule the uninstaller relies on
    (PackageInstaller.cs); the ~38 MB is compressed in place. Not trimmed: three JSON
    (de)serialisations and CoopAgent.TopFrame use reflection the trimmer rejects, and the
    saving is not worth the risk in a process that talks to a game's memory.

    `dotnet build` is untouched (framework-dependent, plain bin\Debug path): that is what
    tools/demo.ps1 and build.ps1 -Install run on the rig, and it starts faster.
    _IsPublishing is what the `dotnet publish` CLI sets; the SDK's own PublishRelease default
    keys off the same property.
  -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KotorCoop.Session\KotorCoop.Session.csproj" />

    <!--
      Optional at RUNTIME, not at build time: KotorCoop.Steam is always published (it is a
      KotorCoop.* file, so tools/package.ps1 is happy), but it loads nothing until something
      asks it to and does nothing at all without a steam_api64.dll the player supplied.
      docs/research/steam-support.md §§10-12.
    -->
    <ProjectReference Include="..\KotorCoop.Steam\KotorCoop.Steam.csproj" />
  </ItemGroup>

  <!--
    Pure arithmetic, no plugin dependency, shared by source so the dashboard's "log" file
    (the run command's log option) rotates the same way the plugin's own logs do. See
    src/KotorCoop.Plugin/LogRotation.cs.
  -->
  <ItemGroup>
    <Compile Include="..\KotorCoop.Plugin\LogRotation.cs" Link="Plugin\LogRotation.cs" />
  </ItemGroup>

</Project>
