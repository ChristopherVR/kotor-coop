    <Compile Include="..\KotorCoop.Protocol\StorePriceRule.cs" Link="Shared\StorePriceRule.cs" />
    <Compile Include="..\KotorCoop.Protocol\StorePriceHookStubBuilder.cs" Link="Shared\StorePriceHookStubBuilder.cs" />
    <Compile Include="..\KotorCoop.Protocol\LocalVarSyncRule.cs" Link="Shared\LocalVarSyncRule.cs" />
    <Compile Include="..\KotorCoop.Protocol\LocalVarAllowlist.cs" Link="Shared\LocalVarAllowlist.cs" />
    <Compile Include="..\KotorCoop.Protocol\LocalVarHookStubBuilder.cs" Link="Shared\LocalVarHookStubBuilder.cs" />

    <!--
      Same technique, one file from KotorCoop.Memory: WineDetection needs to be reachable from
      both this NativeAOT DLL and the ordinary KotorCoop.Agent assembly (which already reaches
      KotorCoop.Memory by reference, via KotorCoop.Session), and this is the only way this
      project ever shares code at all. See WineDetection.cs's own doc comment.
    -->
    <Compile Include="..\KotorCoop.Memory\WineDetection.cs" Link="Shared\WineDetection.cs" />

    <!--
      Same reason: the dedicated co-op save slot (docs/research/session-save.md's 2026-09-25
      entry) is used both here (NewCharacterCaptureController's chargen capture) and from
      KotorCoop.Agent (via KotorCoop.Session -> KotorCoop.Memory). One rule, shared by source.
    -->
    <Compile Include="..\KotorCoop.Memory\CoopSaveSlot.cs" Link="Shared\CoopSaveSlot.cs" />
    <Compile Include="..\KotorCoop.Memory\CoopSaveRedirect.cs" Link="Shared\CoopSaveRedirect.cs" />
  </ItemGroup>

</Project>
