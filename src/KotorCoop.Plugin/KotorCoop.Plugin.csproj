<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The in-process half of the co-op mod, compiled to a native 32-bit DLL with NativeAOT.

    swkotor.exe is x86, so anything loaded into it must be x86. .NET 10's NativeAOT does
    support win-x86, which is what makes it possible to write this in C# instead of C++.

    The output is named dinput8.dll on purpose. The game loads DirectInput from the
    system directory today, and Windows searches the executable's own directory first for
    a DLL that is not a KnownDLL. Dropping this beside swkotor.exe therefore gets it
    loaded by the game itself: no injector, no CreateRemoteThread, nothing to keep alive.
    Every export is re-implemented here and forwarded to the real system DLL.

    Build with build.ps1, which imports the MSVC x86 environment first. NativeAOT shells
    out to link.exe and vswhere.exe, and neither is reachable outside a developer shell.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <Platforms>x86</Platforms>

    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AssemblyName>dinput8</AssemblyName>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Keep the DLL small and its startup cheap; it loads inside a 2003 game. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>

    <!--
      ⚠ ON, against the size preference above, and deliberately. A managed exception that
      escapes an [UnmanagedCallersOnly] entry point kills the game with a fail-fast and no
      SEH exception, so CrashProbe's AppDomain.UnhandledException hook is the ONLY place the
      fault is ever described - and without stack traces that description is a type name and
      a message with no location. One crash class already cost a whole session to a log that
      said nothing. The cost is a few hundred KB in a DLL that loads once.
    -->
    <StackTraceSupport>true</StackTraceSupport>
    <OptimizationPreference>Size</OptimizationPreference>

    <!-- Not part of the normal solution build; publish explicitly via build.ps1. -->
    <IsPublishable>true</IsPublishable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Shared by SOURCE, not by reference. The plugin has no assembly dependencies on purpose —
    it is a NativeAOT x86 DLL loaded into a 2003 game — but this rule must be identical on
    both sides of the wire, and it is the kind of arithmetic that is worth a unit test. Test
    coverage lives with KotorCoop.Protocol; the code compiles into both.
  -->
  <ItemGroup>
    <Compile Include="..\KotorCoop.Session\SteamLaunchRule.cs" Link="Shared\SteamLaunchRule.cs" />
    <Compile Include="..\KotorCoop.Session\SteamConnectStringRule.cs" Link="Shared\SteamConnectStringRule.cs" />
    <Compile Include="..\KotorCoop.Protocol\ModSupportProfile.cs" Link="Shared\ModSupportProfile.cs" />
    <Compile Include="..\KotorCoop.Protocol\DialogueFollowClock.cs" Link="Shared\DialogueFollowClock.cs" />
    <Compile Include="..\KotorCoop.Protocol\DialogueFollowMachine.cs" Link="Shared\DialogueFollowMachine.cs" />
    <Compile Include="..\KotorCoop.Protocol\DialogueNodeFollower.cs" Link="Shared\DialogueNodeFollower.cs" />
    <Compile Include="..\KotorCoop.Protocol\DialogueAutoJoinRule.cs" Link="Shared\DialogueAutoJoinRule.cs" />
    <Compile Include="..\KotorCoop.Protocol\HostLedConversationRule.cs" Link="Shared\HostLedConversationRule.cs" />
    <Compile Include="..\KotorCoop.Protocol\DialogueSkipAuthorityRule.cs" Link="Shared\DialogueSkipAuthorityRule.cs" />
    <Compile Include="..\KotorCoop.Protocol\FollowWarpSettleRule.cs" Link="Shared\FollowWarpSettleRule.cs" />
    <Compile Include="..\KotorCoop.Protocol\NewCharacterWarpHoldRule.cs" Link="Shared\NewCharacterWarpHoldRule.cs" />
    <Compile Include="..\KotorCoop.Protocol\ContainerAnimationEdges.cs" Link="Shared\ContainerAnimationEdges.cs" />
    <Compile Include="..\KotorCoop.Protocol\SoloSegmentCatalogue.cs" Link="Shared\SoloSegmentCatalogue.cs" />
    <Compile Include="..\KotorCoop.Protocol\SoloSegmentMachine.cs" Link="Shared\SoloSegmentMachine.cs" />
    <Compile Include="..\KotorCoop.Protocol\SoloSegmentRule.cs" Link="Shared\SoloSegmentRule.cs" />
    <Compile Include="..\KotorCoop.Protocol\KorribanFinalTestMachine.cs" Link="Shared\KorribanFinalTestMachine.cs" />
    <Compile Include="..\KotorCoop.Protocol\LocalSessionRoleRule.cs" Link="Shared\LocalSessionRoleRule.cs" />
    <Compile Include="..\KotorCoop.Protocol\FriendlyTemplateRule.cs" Link="Shared\FriendlyTemplateRule.cs" />
    <Compile Include="..\KotorCoop.Protocol\LoadProvenance.cs" Link="Shared\LoadProvenance.cs" />
    <Compile Include="..\KotorCoop.Protocol\LocalSaveReadProof.cs" Link="Shared\LocalSaveReadProof.cs" />
    <Compile Include="..\KotorCoop.Protocol\EnemyScalingBaseline.cs" Link="Shared\EnemyScalingBaseline.cs" />
    <Compile Include="..\KotorCoop.Protocol\EnemyScalingBaselineChannel.cs" Link="Shared\EnemyScalingBaselineChannel.cs" />
    <Compile Include="..\KotorCoop.Protocol\EnemyScalingImportGate.cs" Link="Shared\EnemyScalingImportGate.cs" />
