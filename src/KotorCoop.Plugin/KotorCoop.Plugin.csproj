    <Compile Include="..\KotorCoop.Protocol\PartyCensusRule.cs" Link="Shared\PartyCensusRule.cs" />
    <Compile Include="..\KotorCoop.Protocol\ExeImageDigestRule.cs" Link="Shared\ExeImageDigestRule.cs" />
    <Compile Include="..\KotorCoop.Protocol\PhantomAttackerLedger.cs" Link="Shared\PhantomAttackerLedger.cs" />
    <Compile Include="..\KotorCoop.Protocol\ModuleIdentity.cs" Link="Shared\ModuleIdentity.cs" />
    <Compile Include="..\KotorCoop.Protocol\PartyPoolMailboxFence.cs" Link="Shared\PartyPoolMailboxFence.cs" />
    <Compile Include="..\KotorCoop.Protocol\Vector3f.cs" Link="Shared\Vector3f.cs" />
