; coop.ini — copy to your game directory (beside swkotor.exe) and edit.
;
; The agent reads this when run with --menu, and connects when you press the in-game Co-op
; button. You can also connect at any time from the game's own console: press ~ and type
; connect <ip> [password] | disconnect | reconnect. The full list of console commands, and
; which ones are host-only/client-only/either, is in README.txt's "Console commands" section
; (see also docs/research/console-overlay.md for how the console itself works).
; The password can be typed after connect, or kept here.
;
; This file lists every setting a PLAYER would ever want to change; the mod's many internal
; tuning/bisect switches are deliberately not here — see "Everything else" at the bottom.

[coop]

; ------------------------------------------------------------------------------------------
; Connecting
; ------------------------------------------------------------------------------------------
; host = start a session others join; join = connect to a host.
mode = join

; For mode = join: the host's address, e.g. 192.168.1.20 or 192.168.1.20:27140. Ignored when
; hosting. Blank leaves the in-game "Connect to an address..." box empty.
host =

; UDP port. Host and client must match.
port = 27140

; Session password. Empty = open session. A host admits only clients that match.
password =

; Name shown to the other players. Optional: blank = a generated "playerNNN".
name =

; Name shown for this session in the server browser. Falls back to `name` above when unset.
# server_name =

; For mode = join: how you get a character into the host's world. Ignored when hosting.
;   auto          the default - your co-op character is separate from any single-player game
;                 on this install. The FIRST join opens the game's own character creation;
;                 make a character as usual and a few seconds later the mod carries it into
;                 the host's world. It is kept in saves\kotorcoop-character.* and used on
;                 every join after that, refreshed whenever you save while connected.
;   newcharacter  make a new co-op character on this join (replaces the one you have).
;   save          the old way - the character from your own most recent save is what you bring.
join_mode = auto

; When your world does not match the host's, fetch and adopt the host's world instead of
; playing a degraded session (enemies, doors, containers and party all off). Your own saves
; are never touched - only the autosave slot is written. 0 restores the old behaviour.
auto_adopt_world = 1

; Show the main-menu "Co-op" button (Host / Connect / server browser). Set 0 to hide it and
; connect from the ~ console instead.
menu_button = 1

; ------------------------------------------------------------------------------------------
; Your character
; ------------------------------------------------------------------------------------------
; Who may LEAD an area transition the other player follows immediately: `any` (default) lets
; either player's door crossing pull the other along; `host` restores the older behaviour
; where only the host is ever followed.
follow_lead = any

; ------------------------------------------------------------------------------------------
; Difficulty for more than one player (the host's values are used by everyone)
; ------------------------------------------------------------------------------------------
; Each is `auto` (scales with how many players are connected; alone you always get the
; normal game) or a percent from 50 to 400. Two players on auto: enemies have 150% health
; and deal 115% damage, shops hold 150% stock, experience is unchanged.
; enemy_health and enemy_damage are `auto` (both checked in the running game, health including
; save and reload); set either to 100 for the normal game. Store prices
; default to retail 100%; a fixed percent scales both buying and selling by the same amount.
; `auto` currently stays at 100 until a balance curve is chosen.
enemy_health = auto
enemy_damage = auto
xp_rate = auto
store_stock = auto
store_prices = 100

; Be pulled into an ordinary conversation another player starts, instead of clicking the
; same NPC yourself to join: off (default, click/walk over as usual), near (auto-join within
; dialogue_auto_join_range), always (auto-join regardless of distance). A conversation the
; game itself forces on both players (an ambush, a cutscene) always auto-joins regardless.
dialogue_auto_join = off

; The range (game units) dialogue_auto_join = near auto-joins within.
dialogue_auto_join_range = 20

; Hand your camera to the other player while you are downed, so you can watch instead of
; staring at a black screen. 0 disables it.
spectate_on_down = 1

; Return control to your own character the moment you connect (in case you were controlling
; a companion beforehand). 0 disables it.
control_return = 1

; Whether your backpack is your own or shared with the other player.
;   personal  the default - pickups, purchases, sales, drops and crafting stay in YOUR
;             backpack only. Quest/plot items still appear for both players, so the story
;             stays in sync; everything else does not.
;   shared    the older behaviour - every item you pick up or buy also appears for your
;             partner, and vice versa.
inventory_mode = personal

; Whether your credits are your own or one shared party purse. Left unset, this follows
; inventory_mode above (so switching inventory_mode alone keeps credits consistent with it).
;   personal  your own credits, earned and spent locally.
;   shared    one shared purse (the older behaviour).
credits_mode = personal

; What happens to an enemy's loot when you both reach the body. The host's choice applies.
;   shared    the default - one copy for the party: whatever one of you takes is gone for
;             the other too, the same as a chest.
;   personal  each of you finds your own copy of the loot.
corpse_loot = shared

; Duels between players. The host's choice applies.
;   off   the default - players cannot hurt each other.
;   duel  a player can challenge another with "duel <name>"; the other types "accept" or
;         "decline" (no answer in 30 seconds counts as no). Either can type "yield" to stop,
;         and "duel off" refuses every challenge. Both are kept at 1 hp minimum while it lasts,
;         it ends at 25% health, and health and Force points are put back afterwards: nothing
;         is won or lost, and you cannot save during a duel.
pvp = off

; ------------------------------------------------------------------------------------------
; Screen
; ------------------------------------------------------------------------------------------
; On a client, hide the HUD's three party portrait widgets. The companions belong to the
; host (Tab and portrait clicks are locked anyway), so the portraits show state this
; instance does not own. 0 keeps them visible.
hide_party_portraits = 1

; A short line ("co-op: connected, 2 players" / "reconnecting..." / "disconnected") posted
; only when connection state changes.
status_toasts = 1

; A separate, always-on one-line connection summary near the top of the screen. Shows
; nothing while idle. Independent of status_toasts - either can be off without the other.
status_indicator = 1

; An always-on, unobtrusive readout of chat (say <msg> in the ~ console). Lines fade out
; after a delay so the screen is clear the rest of the time.
chat_overlay = 1

; Overlay opacity 0..100. 75 stays readable on the game's bright interiors; lower it for a
; fainter, more transparent overlay.
chat_overlay_opacity = 75

; Overlay corner: top-left | top-right | bottom-left | bottom-right.
chat_overlay_anchor = bottom-left

; How many chat lines to show at once (1..12).
chat_overlay_lines = 5

; Milliseconds a chat line stays before it fades. 0 = never fade.
chat_overlay_fade_ms = 9000

; ------------------------------------------------------------------------------------------
; Controller
; ------------------------------------------------------------------------------------------
; Play with an Xbox-style (XInput) controller. Left stick walks and turns, right stick moves
; the cursor, RT clicks, A = default action, B = back, X = cancel combat, Y = switch
; character, LB/RB = previous/next target, LT = pause, D-pad = action slots 1-4, Start =
; menu, Back = map, LS click = stealth, RS click = cursor mode (both sticks move the cursor,
; A clicks - automatic in menus, conversations and at the main menu). Your swkotor.ini key
; bindings are respected. Typing (passwords, chat, the console) still needs a keyboard.
; Off by default; set 1 to turn it on.
gamepad = 0

; Cursor speed multiplier for the sticks (0.1 - 5).
gamepad_cursor_speed = 1.0

; ------------------------------------------------------------------------------------------
; Internet play
; ------------------------------------------------------------------------------------------
; Steam friends-list "Join Game": while you host, a friend can join straight from Steam's
; friends list instead of being told an IP. Needs both players on Steam and your own
; steam_api64.dll (see the README's Steam section) - harmless to leave on otherwise.
; 0 stops the agent talking to Steam at all.
steam_invites = 1

; STUN servers (host:port, comma-separated) a HOST asks for its own public IP:port, so the
; in-game status can show an internet-reachable address to share. Set to nothing
; (stun_servers = ) to disable discovery - every query is a UDP datagram to a third party.
stun_servers = stun.l.google.com:19302,stun1.l.google.com:19302

; Attempt a UPnP router port mapping when hosting. Fails soft - a router with UPnP off just
; means "forward the port yourself" in the status line, not an error. 0 disables the attempt.
upnp = 1

; A CLIENT'S own fallback for auto_adopt_world: if adopting the host's world can't reach it
; over TCP at all (a UDP-only tunnel or NAT path forwards the co-op session's own UDP traffic
; fine but drops the separate TCP world-transfer connection - found live 2026-09-10 testing a
; playit.gg tunnel), retry the same fetch over a UDP-only channel instead. Only engages after a
; fast, dedicated connect probe finds TCP genuinely unreachable - a slow link or an app-level
; refusal (wrong password, host has no world) is unaffected either way. ON by default since
; 2026-09-18 (it was the one internet path that worked in testing and players had to find and
; flip it by hand); live-verified 2026-09-10 against a real UDP-only tunnel between two machines
; (full transfer, correct world identity, stable reconnect) - see
; docs/research/network-topology.md's UDP world-transfer section. 0 disables the fallback.
world_transfer_udp_fallback = 1

; ------------------------------------------------------------------------------------------
; Advanced
; ------------------------------------------------------------------------------------------
; Plugin/agent log rotation: both kotorcoop-*.log and kotorcoop-agent.log rotate once they
; cross log_max_mb (megabytes), keeping log_keep prior generations (clamped 1-10).
log_max_mb = 8
log_keep = 3

; The plugin normally launches the agent for you the moment it loads. Set 0 only if you are
; running the agent yourself from a command line.
# auto_start_agent = 1

; If another mod already owns dinput8.dll, chain mode (see the README) usually handles it
; automatically. This forces the plugin's next hop by hand if you ever need to override that.
# dinput8_next =

; ------------------------------------------------------------------------------------------
; Everything else
; ------------------------------------------------------------------------------------------
; The mod has many more internal switches - combat mirroring, follow-AI recovery tuning,
; network cadence, diagnostics, and bisect levers used while chasing a bug. Every one of them
; ships at its own verified setting; a player never needs to touch them, and changing one is
; unsupported. They are all listed, with their shipped value and what they do, in
; docs/CONFIG.md's "Developer switches" table.
