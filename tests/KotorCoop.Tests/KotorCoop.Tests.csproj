    <Compile Include="..\..\src\KotorCoop.Plugin\ReviveEffectEventRule.cs" Link="Plugin\ReviveEffectEventRule.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />

    <!--
      For AgentDashboardThreadingTests: a REAL Terminal.Gui IApplication is what makes that
      test worth anything (it proves the actual library's Invoke/threading behaviour, not a
      hand-written stand-in for it) - see that file's own doc comment for the 2026-09-26
      regression it guards. Same version and native-asset exclusion as
      src/KotorCoop.Agent/KotorCoop.Agent.csproj; tests do not publish single-file, so the
      exclusion is not load-bearing here, just consistent.
    -->
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
    <PackageReference Include="TextMateSharp" Version="2.0.4" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
    <PackageReference Include="Onigwrap" Version="1.0.11" ExcludeAssets="native" />
  </ItemGroup>

  <!--
    The plugin is a NativeAOT win-x86 library and cannot be referenced, but the parts of it
    that are PURE ARITHMETIC are the parts most worth testing — the damage ledgers are where
    an off-by-one silently costs a player their whole fight. So those files are compiled in
    here directly rather than having their rules re-implemented in the test (which is what
    EnemyProximityTests had to do, and a mirrored copy of a rule is a rule that can drift).

    Only add dependency-free files here: anything that touches SharedBlockView, Odyssey or
    unsafe engine pointers will not compile in a 64-bit test host.
  -->
  <ItemGroup>
    <!-- Probe artifacts under TestResults are separate temporary projects, not test sources. -->
    <Compile Remove="TestResults/**/*.cs" />
    <Compile Remove="**/obj/**/*.cs" />
    <!-- Custom output paths must not turn earlier validation outputs into source inputs. -->
    <Compile Remove="bin/**/*.cs" />

    <!-- These Win32 guards are tested against dedicated unmanaged pages, never the GC heap.
         The engine-specific address ceiling is preserved using low-address allocations. -->
