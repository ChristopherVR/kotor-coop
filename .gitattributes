# KOTOR game-file assets are binary GFF/2DA/etc. — never apply text/EOL conversion, or
# the byte-for-byte checks (and the game's own loader) would see corrupted files.
*.utc binary
*.uti binary
*.utp binary
*.utd binary
*.utw binary
*.utt binary
*.git binary
*.gff binary
*.2da binary
*.mod binary
*.erf binary
*.rim binary
*.tlk binary
*.bif binary
*.key binary
*.db binary

# install.sh ships inside the Linux tarball; bash cannot parse CRLF, so it stays LF on every
# checkout regardless of core.autocrlf (package.ps1 normalises it again as a second guard).
*.sh text eol=lf

# Preserve audited notice/provenance bytes so manifest hashes survive every checkout.
third-party/NOTICES.txt -text
third-party/grammar-origins.json text eol=lf
third-party/embedded-resource-provenance.json text eol=lf

# Reviewed trailer provenance hashes include its accompanying credit/license files.
site/media/* -text
